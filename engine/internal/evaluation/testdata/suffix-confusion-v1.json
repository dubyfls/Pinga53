{
  "schema_version": 1,
  "fixture_set_id": "scamwall-suffix-confusion",
  "version": "1",
  "description": "Synthetic matching fixtures: sibling pairs whose names differ only in a prefix, so that a rule matching by string suffix rather than by DNS label proposes the legitimate one. Every value is a subdomain of an RFC 2606 documentation-reserved name and resolves to nothing.",
  "provenance": "synthetic",
  "provenance_note": "Written for this repository by this project, for ORDER 6 Stage G. Carries no third-party rights question and no real-world validity: agreement between these labels and this project's own rule is a tautology, not evidence. See docs/EVALUATION_PROTOCOL.md section 3.",
  "partition": "development",
  "baseline_id": "empty-list-v1",
  "baseline_covers": [],
  "baseline_note": "An empty named list, as in the main set. `additional` here means `proposed at all` rather than `added on top of a household's real lists`.",
