# SPDX-License-Identifier: AGPL-3.0-only
# Pinga53 dashboard environment. Copied to /etc/pinga53/dashboard.env by
# install.sh with mode 0640, owned by root:pinga53. The service user reads
# it via EnvironmentFile=.

# REQUIRED. Generate with: openssl rand -hex 32
PINGA53_SECRET_KEY=

# Bind address + port. Pi-hole v6 owns 80/443; the dashboard uses 8053.
PINGA53_BIND=0.0.0.0
PINGA53_PORT=8053

# TLS. Blank => self-signed cert generated on first start at /etc/pinga53/
# dashboard/tls/{cert.pem,key.pem}. Point these at real paths to use your own.
PINGA53_TLS_CERT=
PINGA53_TLS_KEY=

# Pi-hole v6 REST API. The app password is set by the operator with
# `sudo pihole setpassword` and placed here. Never exposed to the browser.
PINGA53_PIHOLE_API=https://127.0.0.1/api
PINGA53_PIHOLE_APP_PASSWORD=
PINGA53_PIHOLE_FTL_DB=/etc/pihole/pihole-FTL.db
PINGA53_PIHOLE_ADMIN_URL=/admin

# MFA is required for v0.2.
PINGA53_REQUIRE_MFA=true

# ScamWall paths (defaults match install.sh — override only if customised).
PINGA53_UNBOUND_CONF=/etc/unbound/unbound.conf.d/pinga53.conf
PINGA53_SCAMWALL_ZONE=/etc/unbound/rpz/scamwall.zone
PINGA53_SCAMWALL_STATE=/var/lib/scamwall
PINGA53_SCAMWALL_STOP_FLAG=/var/lib/scamwall/STOP-AUTOMATIC
PINGA53_SCAMWALL_INSTALL_LOG=/var/log/pinga53/scamwall-install.log

# Root helper (do not change unless you've reinstalled it elsewhere).
PINGA53_HELPER_BIN=/usr/local/sbin/pinga53-helper
PINGA53_USE_SUDO_HELPER=true
